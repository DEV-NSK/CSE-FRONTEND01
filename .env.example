# ── CAMPUSRANK Backend ────────────────────────────────────────────────────────
# Production backend URL
VITE_API_BASE_URL=https://cse-backend-cj6b.onrender.com/api
# Local development:
# VITE_API_BASE_URL=http://localhost:5000/api

# ── Project Hub Integration ───────────────────────────────────────────────────
# Project Hub is an independent application.
# CAMPUSRANK consumes only its public integration surface.
#
# Project Hub frontend (deep links: showcase, create project, public profile)
VITE_PROJECT_HUB_URL=https://projecthub-gilt-zeta.vercel.app
# Project Hub public REST API (public project discovery)
VITE_PROJECT_HUB_API_URL=https://project-hub-2mc4.onrender.com/api
#
# Local development (when running Project Hub locally):
# VITE_PROJECT_HUB_URL=http://localhost:5173
# VITE_PROJECT_HUB_API_URL=http://localhost:4000/api
#
# NOTE: These are public configuration values only.
# Never add Project Hub service-role keys, database credentials,
# GitHub OAuth secrets, or Supabase keys to this file.
